# Server Configuration
PORT=3000
NODE_ENV=development
PUBLIC_URL=http://localhost:3000
STORAGE_DIR=./storage
DB_PATH=./storage/website.sqlite

# Optional Admin Bootstrap (Bootstrap creates an admin account on first boot if no user exists yet)
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

# Optional Email Notifications (Resend)
RESEND_API_KEY=
NOTIFY_FROM=
NOTIFY_TO=

# CLI Password Reset Scripts
TARGET_EMAIL=
NEW_PASSWORD=

# Deployment Domain
DOMAIN=
